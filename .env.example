# Copy to .env and fill in your values.
# Never commit .env to version control.

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aiblock:aiblock@localhost:5432/aiblock

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── S3 / Object storage ───────────────────────────────────────────────────────
S3_BUCKET=aiblock-audio
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Leave empty for AWS; set for MinIO (http://localhost:9000) or Cloudflare R2
S3_ENDPOINT_URL=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create products/prices at https://dashboard.stripe.com/products
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...
